# Copy file này thành .env rồi sửa giá trị: cp .env.example .env

# development | testing | production
APP_ENV=development
SECRET_KEY=change-me
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=DEBUG

# Microsoft SQL Server qua ODBC Driver 18. Thay sql_user/sql_password bằng thông tin được cấp.
# Ký tự đặc biệt trong user/password phải URL-encode (ví dụ @ thành %40).
DATABASE_URL=mssql+pyodbc://sql_user:sql_password@localhost:1433/neko_edu?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# Database riêng cho pytest, tên BẮT BUỘC kết thúc bằng _test (test sẽ xóa sạch dữ liệu DB này)
TEST_DATABASE_URL=mssql+pyodbc://sql_user:sql_password@localhost:1433/neko_edu_test?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# JWT: tối thiểu 32 ký tự. Tạo ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480

# Các origin của frontend được phép gọi API, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Tùy chọn: email khôi phục mật khẩu. Để trống thì API báo chưa cấu hình, không báo gửi thành công.
MAIL_SERVER=
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
FRONTEND_URL=http://127.0.0.1:5173
